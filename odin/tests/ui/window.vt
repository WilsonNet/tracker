# Tracker window end-to-end suite (vinland-ui vui-test runner; headless + sandboxed).
#   /path/to/vinland-ui/build/vui-test odin/tests/ui/window.vt
app ../../bin/tracker-odin ui --session {test}/session
size 1180x760
scale 1
baselines baselines
# 0.5% allows live audio device names in the header/status bar to differ across
# OS/hardware (e.g. "Scarlett 4i4 USB" on CoreAudio vs "... Analog Surround 5.1"
# on PipeWire) while keeping every widget and panel pixel-verified.
threshold 0.005

test "main screen"
  expect-text "Track 1"
  expect-text "Track 4"
  expect-text ARM 4
  expect-text NORMAL
  expect-frame-ms 40
  screenshot main

test "arm, solo, mute toggle"
  click ARM
  expect-class ARM bg-rec
  click SOLO
  expect-class SOLO bg-cue
  click MUTE
  expect-class MUTE bg-ink-muted
  click ARM
  expect-no-class ARM bg-rec
  screenshot toggles

test "input pills select channel"
  click 2
  expect-class 2 bg-sig
  expect-class "Track 1" border-line-sig

test "record requires an armed track"
  click REC
  expect-text "arm a track first"
  click ARM
  click REC
  expect-text "REC"
  wait 10
  click STOP
  expect-text "NORMAL"

test "render dialog range and format"
  type B
  expect-text "Render mix"
  expect-text "RANGE"
  expect-text "FORMAT"
  click-text "24-BIT"
  expect-text "WAV · 24-bit PCM"
  key down
  key right
  key left
  key escape
  expect-no-text "Render mix"
  expect-text NORMAL

test "fx rack via keyboard and tabs"
  type x
  expect-text "TRACK 1"
  expect-text EQ
  expect-text COMP
  expect-text SEND
  screenshot fx-track
  click MST
  expect-text MASTER
  expect-text REVERB
  expect-text LIMITER
  screenshot fx-master
  key escape
  wait 3

test "fx power toggle"
  type x
  click ON
  expect-text BYP
  click BYP
  wait 2

test "knob drag changes value"
  type x
  expect-exact "+0.0" 3
  drag-text LOW 0 -60
  expect-exact "+0.0" 2
  expect-exact "+12.7"
  screenshot knob-dragged

test "bpm stepper"
  expect-text 120
  click +
  expect-text 121
  click −
  click −
  expect-text 119

test "command palette"
  type :
  expect-text Commands
  type sav
  expect-text "save project"
  screenshot palette
  key escape
  expect-no-text Commands

test "io overlay"
  click I/O
  expect-text "Input devices"
  expect-text RESCAN
  key escape
  expect-no-text "Input devices"

test "rhythm toggle"
  click RHYTHM
  expect-text "BPM · 4/4"
  click RHYTHM
  expect-no-text "BPM · 4/4"

test "undo after mute"
  click MUTE
  expect-class MUTE bg-ink-muted
  click UNDO
  expect-no-class MUTE bg-ink-muted

test "minimum window size"
  resize 900 620
  expect-text "Track 4"
  expect-text RHYTHM
  screenshot min-size

test "shift drag is fine"
  type x
  drag-text LOW 0 -60 shift
  expect-exact "+0.0" 2
  expect-exact "+1.5"
  screenshot shift-drag

test "settings menu edits project folder"
  click-text SET
  expect-text "Project folder"
  expect-text "Capture backend"
  key down
  key down
  expect-class APPLY ring-sig
  key up
  key up
  expect-no-class APPLY ring-sig
  key enter
  type "/e2e"
  key enter
  expect-text "saving to"
  expect-text e2e
  key escape
  expect-no-text "Machine preferences"

test "settings text field selection and secret mask"
  click-text SET
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  click-text "Client ID"
  expect-class "Client ID" cursor-text
  type "alpha-beta"
  # Keyboard selection replaces exactly the selected word.
  key home
  key right shift
  key right shift
  key right shift
  key right shift
  key right shift
  type "Z"
  expect-exact "Z-beta"
  # Double-click selects a word; typing replaces it.
  dblclick "Z-beta"
  type "Q"
  expect-exact "Z-Q"
  # Tab moves to the secret without losing the ID draft.
  key tab
  type "s3cret"
  expect-text "******"
  expect-no-text "s3cret"
  key tab shift
  type x
  expect-exact "Z-Qx"
  # Secrets stay masked after saving.
  key tab
  key enter
  expect-text "******"
  expect-no-text "s3cret"
  key escape

test "cloud settings and overlay are reachable"
  click-text SET
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  expect-text "Drive folder"
  key escape
  type g
  expect-text "Cloud projects"
  expect-text "Connect Google Drive in Settings"
  key escape
  expect-no-text "Google Drive · hidden app data"
