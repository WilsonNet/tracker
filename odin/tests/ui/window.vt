# Tracker window end-to-end suite (vinland-ui vui-test runner; headless + sandboxed).
#   /path/to/vinland-ui/build/vui-test odin/tests/ui/window.vt
app ../../bin/tracker-odin ui --session {test}/session
size 1180x760
scale 1
baselines baselines
# 0.5% allows live audio device names in the header/status bar to differ across
# OS/hardware (e.g. "Scarlett 4i4 USB" on CoreAudio vs "... Analog Surround 5.1"
# on PipeWire) while keeping every widget and panel pixel-verified.
threshold 0.005

test "main screen"
  expect-text "Track 1"
  expect-text "Track 4"
  expect-text ARM 4
  expect-text NORMAL
  expect-frame-ms 40
  screenshot main

test "arm, solo, mute toggle"
  click ARM
  expect-class ARM bg-rec
  click SOLO
  expect-class SOLO bg-cue
  click MUTE
  expect-class MUTE bg-ink-muted
  click ARM
  expect-no-class ARM bg-rec
  screenshot toggles

test "input pills select channel"
  click 2
  expect-class 2 bg-sig
  expect-class "Track 1" border-line-sig

test "record requires an armed track"
  click REC
  expect-text "arm a track first"
  click ARM
  click REC
  expect-text "REC"
  wait 10
  click STOP
  expect-text "NORMAL"

test "render dialog range and format"
  type B
  expect-text "Render mix"
  expect-text "RANGE"
  expect-text "FORMAT"
  click-text "24-BIT"
  expect-text "WAV · 24-bit PCM"
  key down
  key right
  key left
  key escape
  expect-no-text "Render mix"
  expect-text NORMAL

test "fx rack via keyboard and tabs"
  type x
  expect-text "TRACK 1"
  expect-text EQ
  expect-text COMP
  expect-text SEND
  screenshot fx-track
  click MST
  expect-text MASTER
  expect-text REVERB
  expect-text LIMITER
  screenshot fx-master
  key escape
  wait 3

test "fx power toggle"
  type x
  click ON
  expect-text BYP
  click BYP
  wait 2

test "knob drag changes value"
  type x
  expect-exact "+0.0" 3
  drag-text LOW 0 -60
  expect-exact "+0.0" 2
  expect-exact "+12.7"
  screenshot knob-dragged

test "bpm stepper"
  expect-text 120
  click +
  expect-text 121
  click −
  click −
  expect-text 119

test "command palette"
  type :
  expect-text Commands
  type sav
  expect-text "save project"
  screenshot palette
  key escape
  expect-no-text Commands

test "f1 contextual help"
  expect-text "F1 keys"
  key f1
  expect-text "Mixer"
  expect-text "record at playhead"
  screenshot help-mixer
  type 1
  key escape
  expect-no-text "record at playhead"
  type :
  key f1
  expect-text "Command palette"
  expect-text "filter commands"
  expect-no-text "record at playhead"
  screenshot help-palette
  key f1
  expect-text Commands
  key escape

test "add tracks, zoom and page"
  expect-text TRACKS
  type NN
  expect-text "Track 6"
  expect-no-text "Track 1"
  type }
  expect-text "Track 1"
  screenshot tracks-six
  type {{
  type D
  expect-text "Track 5"
  key f1
  expect-text "Track count"
  key escape

test "bounce marked tracks to a track dialog"
  type v
  click "→ TRACK"
  expect-text "Bounce to track"
  expect-text "SOURCES"
  expect-text "track 2 is empty"
  screenshot bounce-to-track
  type j
  expect-text "track 3 is empty"
  key escape
  expect-no-text SOURCES

test "twenty-four tracks at minimum size"
  resize 900 620
  type NNNNNNNNNNNNNNNNNNNN
  expect-text "Track 24"
  expect-text "24"
  type }}}}
  screenshot tracks-24-min
  type (
  type )

test "rename a track inline"
  key k
  type R
  expect-text "track name"
  type "Lead Gtr"
  key enter
  expect-text "Lead Gtr"
  screenshot track-renamed
  dblclick "Lead Gtr"
  type "Bass"
  key enter
  expect-text "Bass"
  expect-no-text "Lead Gtr"

test "delete track asks before removing audio"
  type N
  type N
  expect-text "TRACKS"
  type D
  expect-no-text "Delete track?"
  # the with-audio dialog is covered by unit tests (e2e has no recorded takes)

test "pause, marker and pre-roll"
  expect-text PRE-ROLL
  expect-text "3 s"
  click PRE-ROLL
  expect-text "5 s"
  type M
  expect-text MARK
  expect-text "marker"
  # PLAY/PAUSE needs an output device, so the pause path is covered by unit tests
  screenshot transport-marker
  key f1
  expect-text "marker here"
  expect-text "play / pause here"
  key escape
  type ,
  expect-text "Pre-roll before a take"
  key escape

test "io overlay"
  click I/O
  expect-text "Input devices"
  expect-text RESCAN
  key escape
  expect-no-text "Input devices"

test "rhythm toggle"
  click RHYTHM
  expect-text "BPM · 4/4"
  click RHYTHM
  expect-no-text "BPM · 4/4"

test "undo after mute"
  click MUTE
  expect-class MUTE bg-ink-muted
  click UNDO
  expect-no-class MUTE bg-ink-muted

test "minimum window size"
  resize 900 620
  expect-text "Track 4"
  expect-text RHYTHM
  screenshot min-size

test "shift drag is fine"
  type x
  drag-text LOW 0 -60 shift
  expect-exact "+0.0" 2
  expect-exact "+1.5"
  screenshot shift-drag

test "settings menu edits project folder"
  click-text SET
  expect-text "Project name"
  expect-text "Project folder"
  expect-text "Capture backend"
  key down
  key down
  key down
  expect-class APPLY ring-sig
  key up
  key up
  expect-no-class APPLY ring-sig
  key enter
  type "/e2e"
  key enter
  expect-text "saving to"
  expect-text e2e
  key escape
  expect-no-text "Machine preferences"

test "settings text field selection and secret mask"
  click-text SET
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  wait 15
  click-text "Client ID"
  expect-class "Client ID" cursor-text
  expect-text EDIT
  type "alpha-beta"
  # Keyboard selection replaces exactly the selected word.
  key home
  key right shift
  key right shift
  key right shift
  key right shift
  key right shift
  type "Z"
  expect-exact "Z-beta"
  # Double-click selects a word; typing replaces it.
  dblclick "Z-beta"
  type "Q"
  expect-exact "Z-Q"
  # Tab moves to the secret without losing the ID draft.
  key tab
  type "s3cret"
  expect-text "******"
  expect-no-text "s3cret"
  key tab shift
  type x
  expect-exact "Z-Qx"
  # Secrets stay masked after saving.
  key tab
  key enter
  expect-text "******"
  expect-no-text "s3cret"
  key escape

test "cloud settings and overlay are reachable"
  click-text SET
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  key down
  expect-text "Drive folder"
  key escape
  type g
  expect-text "Cloud projects"
  expect-text "Connect Google Drive in Settings"
  key escape
  expect-no-text "Google Drive · hidden app data"

test "rename project inline from status bar"
  click-text "untitled"
  expect-text EDIT
  type "Midnight Tape"
  key enter
  expect-text "Midnight Tape"
  expect-text "project named Midnight Tape"
  expect-no-text EDIT

test "rename project in settings and cloud overlay"
  click-text SET
  expect-text "Project name"
  key enter
  key a ctrl
  type "Studio Session"
  key enter
  expect-text "project named Studio Session"
  key escape
  expect-no-text "Machine preferences"
  type g
  expect-text "Studio Session"
  expect-text "RENAME"
  click RENAME
  expect-text EDIT
  key escape
  expect-no-text EDIT
  expect-text "Studio Session"

test "tape scrubber shuttle jog wheels and modifiers"
  expect-text "SHUTTLE"
  expect-text "JOG"
  expect-text "5.0s"
  expect-text "250ms"
  type ">"
  expect-text "00:00:05.000"
  type l
  expect-text "00:00:05.250"
  type L
  expect-text "00:00:05.300"
  scroll -48 563 731
  expect-text "00:00:10.300"
  scroll 48 563 731 shift
  expect-text "00:00:09.300"
  scroll -48 653 731 shift
  expect-text "00:00:09.350"
  scroll -48 653 731 ctrl
  expect-text "00:00:09.360"
  type 0
  expect-text "00:00:00.000"
  type ">"
  expect-text "00:00:05.000"
  click-text "|◄"
  expect-text "00:00:00.000"
